{
  "name": "mora",
  "version": "0.1.0",
  "description": "Mora is a minimal, beautiful and local-first Markdown editor.",
  "main": "./out/main/index.js",
  "author": "Mora contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm typecheck && electron-vite build",
    "build:win": "pnpm build && electron-builder --win --x64",
    "build:win:installer": "pnpm build && electron-builder --win nsis --x64",
    "build:win:portable": "pnpm build && electron-builder --win portable --x64",
    "preview": "electron-vite preview"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.2",
    "codemirror": "^6.0.2",
    "dompurify": "^3.2.6",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.7",
    "@vitejs/plugin-vue": "^5.2.4",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.21.5",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.4.14",
    "vitest": "^2.1.9",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.0"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "electron-winstaller"
    ],
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
